# Copy to .env.local only for an explicitly authorised Wix read session.
# Server-only values: never prefix these names with NEXT_PUBLIC_.
# Never commit, print, or paste real credentials into project documentation.

WIX_SITE_ID=
WIX_API_KEY=
# Reserved for a separately approved native Wix Forms integration.  The current
# application never reads it and remains unable to collect enquiries.
WIX_FORMS_API_KEY=
