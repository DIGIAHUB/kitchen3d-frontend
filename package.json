{
  "name": "kitchen3d-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --no-cache --max-warnings=0 --ext .js,.jsx,.mjs,.ts,.tsx src scripts",
    "typecheck": "tsc --noEmit --incremental false",
    "check:inventory": "node scripts/check-inventory.mjs",
    "check:content": "node scripts/check-content.mjs",
    "validate:local": "npm run lint && npm run typecheck && npm run check:inventory && npm run check:content"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18",
    "next": "14.2.35"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35"
  }
}
