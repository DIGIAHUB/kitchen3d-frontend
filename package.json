{
  "name": "kitchen3d-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.18.0 <25", "npm": ">=11.16.0 <12" },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --no-cache --max-warnings=0 --ext .js,.jsx,.mjs,.ts,.tsx src scripts",
    "typecheck": "tsc --noEmit --incremental false",
    "check:inventory": "node scripts/check-inventory.mjs",
    "check:content": "node scripts/check-content.mjs",
    "validate:local": "npm run lint && npm run typecheck && npm run check:inventory && npm run check:content"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next": "16.3.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5"
  }
}
